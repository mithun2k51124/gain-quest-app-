{
  "expo": {
    "name": "GainQuest",
    "slug": "gainquest-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gainquest.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.gainquest.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "GainQuest needs access to your photos to save progress pics.",
          "cameraPermission": "GainQuest needs camera access to capture your progress."
        }
      ]
    ],
    "scheme": "gainquest",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dfa8e78-1a73-4fac-84de-bbc5d9eef9dc"
      }
    }
  }
}
